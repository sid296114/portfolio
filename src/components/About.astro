---
import { site } from '../data/site';
---

<section id="about" class="py-20 md:py-28">
  <div class="reveal mx-auto max-w-5xl px-6">
    <h2 class="mb-10 text-2xl font-bold md:text-3xl">关于我</h2>
    <div class="flex flex-col items-center gap-8 md:flex-row md:items-start">
      <img
        src="/assets/avatar.svg"
        alt="李鑫志的头像"
        width="160"
        height="160"
        loading="lazy"
        class="rounded-full"
      />
      <p class="max-w-2xl leading-relaxed text-light-text-secondary dark:text-dark-text-secondary">
        {site.about}
      </p>
    </div>
  </div>
</section>
